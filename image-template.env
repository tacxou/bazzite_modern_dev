# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=bazzite_modern_dev

# Make this the same as your github username/organisation
REPO_ORGANIZATION="tacxou"

IMAGE_DESC="Bazzite Modern Development Environment"
IMAGE_KEYWORDS="bazzite,modern,development,environment"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/tacxou/bazzite_modern_dev/main/assets/logo.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/tacxsoftware/bazzite-modern-dev-image-builder:latest"
